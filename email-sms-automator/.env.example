# =====================================================================
# email-sms-automator Configuration Template
# =====================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env`:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Replace the placeholder values below with your actual credentials.
# 3. WARNING: NEVER COMMIT YOUR REAL `.env` FILE TO GITHUB OR ANY PUBLIC REPOSITORY!
# =====================================================================

# ---------------------------------------------------------------------
# Sender Email Credentials (Gmail recommended)
# ---------------------------------------------------------------------
# Your full email address
SENDER_EMAIL=your_email@gmail.com

# 16-character App Password generated from Google Account (NOT your regular login password!)
# How to get Gmail App Password:
# 1. Go to your Google Account (https://myaccount.google.com/)
# 2. Select "Security" on the left menu
# 3. Ensure "2-Step Verification" (2FA) is turned ON
# 4. Search for or select "App passwords"
# 5. Create a new App Password (e.g. named "Python Automator")
# 6. Copy the 16-character password and paste it below (without spaces)
SENDER_APP_PASSWORD=your_16_digit_app_password

# ---------------------------------------------------------------------
# Mail Server Configuration
# ---------------------------------------------------------------------
# SMTP Server for sending emails (Gmail: smtp.gmail.com, Outlook: smtp.office365.com)
SMTP_SERVER=smtp.gmail.com

# SMTP Port (587 for STARTTLS)
SMTP_PORT=587

# IMAP Server for receiving emails (Gmail: imap.gmail.com, Outlook: outlook.office365.com)
IMAP_SERVER=imap.gmail.com

# ---------------------------------------------------------------------
# Test Recipient Targets
# ---------------------------------------------------------------------
# An email address you own/control to receive test emails (e.g. secondary email or work email)
TEST_RECIPIENT_EMAIL=another_email@example.com

# Phone number to receive test SMS (10 digits, numbers only, e.g., 1234567890)
TEST_SMS_PHONE_NUMBER=1234567890

# Carrier key for email-to-SMS gateway:
# Supported carriers: att, verizon, tmobile, sprint, boost, cricket, us_cellular
TEST_SMS_CARRIER=att
